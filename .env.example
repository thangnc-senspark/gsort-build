# Copy to .env and fill in. Never put real values in this file.

# Android signing (same as Jenkins credentials keystore-password / alias-password)
ANDROID_KEYSTORE_PASS=
ANDROID_KEYALIAS_PASS=

# Dashboard port
PORT=4567
# 127.0.0.1 = only this machine. 0.0.0.0 = anyone on the LAN (no login on the dashboard).
HOST=127.0.0.1
